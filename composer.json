{
    "name": "skillcraft/credential-vault",
    "description": "Secure per-tenant encrypted credential storage for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Skillcraft\\CredentialVault\\": "src/"
        }
    },
    "require": {
        "php": "^8.4|^8.5",
        "illuminate/console": "^13",
        "illuminate/contracts": "^13",
        "illuminate/database": "^13",
        "illuminate/encryption": "^13",
        "illuminate/log": "^13",
        "illuminate/support": "^13"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/ai": "^1.3",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-drift": "^4.1",
        "rector/rector": "^2.3"
    },
    "suggest": {
        "laravel/ai": "Required for the optional production-agent tools (^1.3)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Skillcraft\\CredentialVault\\Providers\\CredentialVaultServiceProvider"
            ],
            "aliases": {
                "Vault": "Skillcraft\\CredentialVault\\Facades\\Vault"
            }
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse -c phpstan.neon --memory-limit=512M",
        "analyse:baseline": "phpstan analyse -c phpstan.neon --generate-baseline --memory-limit=512M",
        "refactor": "rector process",
        "refactor:check": "rector process --dry-run",
        "check": [
            "@lint:check",
            "@analyse",
            "@test:coverage"
        ],
        "test": "vendor/bin/pest --no-coverage",
        "test:compact": "vendor/bin/pest --no-coverage --compact",
        "test:unit": "vendor/bin/pest --no-coverage tests/Unit",
        "test:integration": "vendor/bin/pest --no-coverage tests/Feature",
        "test:coverage": "vendor/bin/pest --coverage --stop-on-failure"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Skillcraft\\CredentialVault\\Tests\\": "tests/",
            "Tests\\Unit\\Packages\\SkillcraftCredentialVault\\": "tests/Unit/",
            "Tests\\Feature\\Packages\\SkillcraftCredentialVault\\": "tests/Feature/"
        }
    }
}
